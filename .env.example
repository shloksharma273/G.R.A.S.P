# G.R.A.S.P — Knowledge Graph Read Harness — configuration (PRD Section 8)
# Copy to .env and fill in.  Load with:  set -a && source .env && set +a
# .env is gitignored; NEVER put real credentials in this template file.

# --- required -----------------------------------------------------------------
ARANGO_URL=https://your-instance.example.com
ARANGO_DB=your_database
PROJECT_NAME=roboticsPlanner

# Either username + password ...
ARANGO_USERNAME=root
ARANGO_PASSWORD=
# ... or a JWT bearer token instead (leave the two above unset if you use this):
# ARANGO_AUTH_TOKEN=

# --- optional: names, confirmed once against the live instance ----------------
# ENTITY_COLLECTION={PROJECT_NAME}_Entities
# RELATION_COLLECTION={PROJECT_NAME}_Relations
# ENTITY_TYPE_FIELD=entity_type
# DESCRIPTION_FIELD=description
# RELATION_TYPE=RELATED_TO
ENTITY_NAME_FIELD=entity_name      # AutoGraph stores entity_name, not name
# RELATION_TYPE_FIELD=type

# --- optional: read shaping and output ----------------------------------------
# ENTITY_TYPE_FILTER=SKILL,PRIMITIVE,OBJECT,STATE   # case-insensitive; some
#                                                   # builds emit skill,tool,object,state
# OUTPUT_FORMAT=table
# LIMIT=0

# --- Station 3: LLM Disambiguator ---------------------------------------------
# The first key variable that is set wins. NEVER commit a real key.
OPENROUTER_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1     # any OpenAI-compatible endpoint
# LLM_MODEL=anthropic/claude-opus-5
# LLM_TEMPERATURE=0                             # Section 7: determinism
# LLM_CONFIDENCE_THRESHOLD=0.75                 # below this -> parked low_confidence
# LLM_BATCH_SIZE=10
# LLM_MAX_REQUESTS=50                           # per-run spend cap; 0 = make no call
# LLM_LEXICAL_PREPASS=1                         # 0 for a pure-LLM run
# LLM_CACHE=1
# LLM_CACHE_PATH=.grasp_cache/station3.json
# LLM_MAX_RETRIES=3
# LLM_MAX_TOKENS=4000
# LLM_REASONING=0                               # 1 to let the model think first

# --- Station 5: PlanGraph Writer ----------------------------------------------
# Station 5 is the only part of the bridge that WRITES. A plain run is a dry run;
# pass --write to apply. A scoped rebuild DELETES the task's existing subgraph.
# PLANGRAPH_PREFIX=roboticsPlanner        # collections: {prefix}_Skills, _PlanEdges, ...
# SKILL_SCOPE=                            # default: inferred from the input's single skill
# PLANGRAPH_BUILD_ID=                     # default: a hash of the input (not a clock)
# PLANGRAPH_EMBEDDING_FIELD=description
# ARANGO_WRITE_USERNAME=                  # a writing user, if distinct from Station 1's
# ARANGO_WRITE_PASSWORD=
# AUTOGRAPH_URL=                          # embed-field endpoint; unset = index not built
# AUTOGRAPH_API_KEY=
